# ============================================================================
# PermisoHub — Variables de entorno
#
# Copia este archivo a .env.local y completa los valores.
# En Vercel: Settings → Environment Variables (marca los NEXT_PUBLIC_* como
# expuestos al cliente; el resto son secretos de servidor).
# NUNCA commitees .env.local (está en .gitignore).
# ============================================================================

# ── Supabase (REQUERIDO) ────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role: SOLO servidor (crons, webhooks, jobs). Bypassa RLS — no exponer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (REQUERIDO para todas las herramientas IA) ──────────────────────
# Due diligence, anotación de planos, asesor de vía, chat OGUC, etc. (gpt-4o)
OPENAI_API_KEY=sk-...

# ── URLs de la app ──────────────────────────────────────────────────────────
# URL pública base (links de portal, invitaciones, crons, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL usada por Stripe Checkout/Portal para success/cancel (normalmente igual)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Webhook: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs por plan (Dashboard → Products)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ESTUDIO_MONTHLY=price_...
STRIPE_PRICE_ESTUDIO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# ── Resend (emails transaccionales y resúmenes) ────────────────────────────
RESEND_API_KEY=re_...
# Destinatario de reportes admin y resúmenes de cron
ADMIN_EMAIL=admin@tudominio.cl

# ── Twilio (notificaciones WhatsApp) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Número WhatsApp habilitado, formato: whatsapp:+56912345678
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Upstash Redis (rate limiting de rutas IA) ──────────────────────────────
# Sin estas variables el rate limit queda DESACTIVADO (fail-open).
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Crons (Vercel Cron) ─────────────────────────────────────────────────────
# Debe coincidir con el header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=un-secreto-largo-aleatorio

# ── Flags de desarrollo (NUNCA en producción) ──────────────────────────────
# Todas exigen NODE_ENV !== 'production' — aún así, no las setees en Vercel.
# BYPASS_AUTH=true       → auto-login dev vía /auth/dev-login
# DEV_USER_EMAIL=tu@correo.cl  → usuario del auto-login dev
# DEMO_MODE=true         → salta auth y límites de plan (solo demos locales)
# NEXT_PUBLIC_DEMO_MODE=true   → ídem, horneado en build
